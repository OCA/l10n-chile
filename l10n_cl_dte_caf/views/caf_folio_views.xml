<odoo>
    <record id="view_caf_folio_list" model="ir.ui.view">
        <field name="name">l10n_cl.caf.folio.list</field>
        <field name="model">l10n_cl.caf.folio</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="authorization_id" />
                <field name="number" />
                <field name="document_id" />
                <field name="state" />
                <field name="reserved_at" />
                <field name="reserved_by" />
            </list>
        </field>
    </record>
    <record id="view_caf_folio_search" model="ir.ui.view">
        <field name="name">l10n_cl.caf.folio.search</field>
        <field name="model">l10n_cl.caf.folio</field>
        <field name="arch" type="xml">
            <search>
                <field name="number" />
                <field name="authorization_id" />
                <field name="document_id" />
                <filter
                    name="reserved"
                    string="Reserved"
                    domain="[('state', '=', 'reserved')]"
                />
                <filter
                    name="issued"
                    string="Issued"
                    domain="[('state', '=', 'issued')]"
                />
                <filter name="void" string="Voided" domain="[('state', '=', 'void')]" />
                <group string="Group By">
                    <filter
                        name="group_authorization"
                        string="CAF"
                        context="{'group_by': 'authorization_id'}"
                    />
                    <filter
                        name="group_document"
                        string="DTE"
                        context="{'group_by': 'document_id'}"
                    />
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_caf_folio_form" model="ir.ui.view">
        <field name="name">l10n_cl.caf.folio.form</field>
        <field name="model">l10n_cl.caf.folio</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="Folio Identity">
                            <field name="authorization_id" />
                            <field name="document_code" />
                            <field name="number" />
                            <field name="document_id" />
                            <field name="state" />
                        </group>
                        <group string="Reservation">
                            <field name="reserved_at" />
                            <field name="reserved_by" />
                            <field name="issued_at" />
                            <field name="voided_at" />
                            <field name="void_reason" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_caf_folio" model="ir.actions.act_window">
        <field name="name">Reserved Folios</field>
        <field name="res_model">l10n_cl.caf.folio</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_caf_folio_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_caf_folio_form')})]"
        />
        <field name="search_view_id" ref="view_caf_folio_search" />
    </record>
</odoo>
