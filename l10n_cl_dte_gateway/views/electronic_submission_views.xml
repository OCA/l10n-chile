<odoo>
    <record id="view_electronic_submission_list" model="ir.ui.view">
        <field name="name">l10n_cl.electronic.submission.list</field>
        <field name="model">l10n_cl.electronic.submission</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="document_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="environment" />
                <field name="is_simulated" string="Simulated" />
                <field name="state" />
                <field name="track_id" />
                <field name="submitted_at" optional="hide" />
                <field name="last_checked_at" optional="hide" />
            </list>
        </field>
    </record>
    <record id="view_electronic_submission_search" model="ir.ui.view">
        <field name="name">l10n_cl.electronic.submission.search</field>
        <field name="model">l10n_cl.electronic.submission</field>
        <field name="arch" type="xml">
            <search>
                <field name="document_id" />
                <field name="track_id" />
                <field name="environment" />
                <filter
                    name="needs_attention"
                    string="Needs Attention"
                    domain="[('state', 'in', ['error', 'outcome_unknown'])]"
                />
                <filter
                    name="in_progress"
                    string="In Progress"
                    domain="[('state', 'in', ['sending', 'submitted', 'processing'])]"
                />
                <filter
                    name="demo"
                    string="Demo"
                    domain="[('environment', '=', 'demo')]"
                />
                <group string="Group By">
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                    <filter
                        name="group_environment"
                        string="Environment"
                        context="{'group_by': 'environment'}"
                    />
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_electronic_submission_form" model="ir.ui.view">
        <field name="name">l10n_cl.electronic.submission.form</field>
        <field name="model">l10n_cl.electronic.submission</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button
                        name="action_enqueue_submission"
                        type="object"
                        string="Queue Submission"
                        class="btn-primary"
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="state != 'pending'"
                    />
                    <button
                        name="action_enqueue_status_query"
                        type="object"
                        string="Query SII Status"
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="state not in ['submitted', 'processing', 'outcome_unknown'] or not track_id"
                    />
                    <button
                        name="action_enqueue_reconciliation"
                        type="object"
                        string="Reconcile Unknown Outcome"
                        groups="l10n_cl_dte_core.group_dte_manager"
                        invisible="state != 'outcome_unknown'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="document_id" />
                        <field name="company_id" />
                        <field name="environment" />
                        <field name="is_simulated" string="Simulated" readonly="1" />
                        <field
                            name="demo_scenario"
                            invisible="environment != 'demo'"
                            readonly="state != 'pending' or environment != 'demo'"
                        />
                        <field name="track_id" />
                        <field name="idempotency_key" readonly="1" />
                    </group>
                    <group string="Transport Timeline">
                        <field name="submitted_at" />
                        <field name="last_checked_at" />
                    </group>
                    <notebook>
                        <page string="Transport Attempts">
                            <field name="attempt_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="operation" />
                                    <field name="state" />
                                    <field name="started_at" />
                                    <field name="completed_at" />
                                    <field name="request_digest" />
                                    <field name="response_digest" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_electronic_submission" model="ir.actions.act_window">
        <field name="name">SII Submissions</field>
        <field name="res_model">l10n_cl.electronic.submission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_electronic_submission_search" />
    </record>
</odoo>
