<odoo>
    <record id="view_electronic_document_list" model="ir.ui.view">
        <field name="name">l10n_cl.electronic.document.list</field>
        <field name="model">l10n_cl.electronic.document</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="document_code" />
                <field name="sii_environment" />
                <field name="folio" />
                <field name="preparation_state" />
                <field name="fiscal_state" />
            </list>
        </field>
    </record>
    <record id="view_electronic_document_search" model="ir.ui.view">
        <field name="name">l10n_cl.electronic.document.search</field>
        <field name="model">l10n_cl.electronic.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="source_key" />
                <field name="document_code" />
                <field name="sii_environment" />
                <field name="folio" />
                <filter
                    name="pending"
                    string="Preparation Pending"
                    domain="[('preparation_state', '!=', 'queued')]"
                />
                <filter
                    name="fiscal_attention"
                    string="Needs Attention"
                    domain="[('fiscal_state', 'in', ['rejected', 'outcome_unknown'])]"
                />
                <filter
                    name="demo"
                    string="Demo"
                    domain="[('sii_environment', '=', 'demo')]"
                />
                <group string="Group By">
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                    <filter
                        name="group_environment"
                        string="Environment"
                        context="{'group_by': 'sii_environment'}"
                    />
                    <filter
                        name="group_document_code"
                        string="Document Type"
                        context="{'group_by': 'document_code'}"
                    />
                    <filter
                        name="group_preparation_state"
                        string="Preparation"
                        context="{'group_by': 'preparation_state'}"
                    />
                    <filter
                        name="group_fiscal_state"
                        string="SII Status"
                        context="{'group_by': 'fiscal_state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_electronic_document_form" model="ir.ui.view">
        <field name="name">l10n_cl.electronic.document.form</field>
        <field name="model">l10n_cl.electronic.document</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" readonly="1" />
                        <field name="company_id" readonly="1" />
                        <field name="sii_environment" readonly="1" />
                        <field name="document_code" readonly="1" />
                        <field name="folio" readonly="1" />
                        <field name="preparation_state" readonly="1" />
                        <field name="fiscal_state" readonly="1" />
                        <field name="source_key" readonly="1" />
                        <field name="payload_digest" readonly="1" />
                    </group>
                    <notebook>
                        <page string="Evidence">
                            <field name="artifact_ids" />
                        </page>
                        <page string="Audit Events">
                            <field name="event_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_electronic_document" model="ir.actions.act_window">
        <field name="name">Electronic Documents</field>
        <field name="res_model">l10n_cl.electronic.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_electronic_document_search" />
    </record>
</odoo>
