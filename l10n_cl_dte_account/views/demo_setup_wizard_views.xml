<odoo>
    <record id="view_dte_demo_setup_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.demo.setup.wizard.form</field>
        <field name="model">l10n_cl.dte.demo.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Prepare Synthetic DTE Demo Configuration">
                <div class="alert alert-warning" role="alert">
                    This creates synthetic Demo CAFs for the selected DTE types,
                    a trust key, and a disposable signing certificate for this
                    company. The current invoice issuance action supports type 33.
                    These records are local simulation material and are never
                    valid for Certification, Production, or submission to the SII.
                </div>
                <group>
                    <field name="company_id" />
                    <field name="allowed_document_type_ids" invisible="1" />
                    <field name="document_type_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}" />
                    <field name="confirm_synthetic_data" />
                </group>
                <footer>
                    <button
                        name="action_create_configuration"
                        type="object"
                        string="Create Synthetic Demo Configuration"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
