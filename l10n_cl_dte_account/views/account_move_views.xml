<odoo>
    <record id="view_move_form_dte_issuance" model="ir.ui.view">
        <field name="name">account.move.form.dte.issuance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button
                    name="issue_dte"
                    type="object"
                    string="Issue DTE"
                    class="btn-primary"
                    groups="l10n_cl_dte_core.group_dte_user"
                    invisible="state != 'posted' or move_type != 'out_invoice' or dte_document_type_code not in ['33', '34']"
                />
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="l10n_latam_document_type_id" invisible="1" />
                <field name="dte_document_type_code" invisible="1" />
                <field name="dte_document_ids" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="view_move_form_dte_document_type_reset" model="ir.ui.view">
        <field name="name">account.move.form.dte.document.type.reset</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_latam_invoice_document.view_move_form" />
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_latam_document_type_id']" position="attributes">
                <attribute name="readonly">state != 'draft' or dte_document_ids</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="posted_before" invisible="1" />
                <field name="dte_document_ids" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
